# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string
DATABASE_URL=""

# Random secret for sign-in sessions: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the app (http://localhost:5173 locally, https://<your-domain> in production)
BETTER_AUTH_URL="http://localhost:5173"
# Extra origins allowed to sign in, comma-separated (e.g. http://192.168.0.101:5173)
TRUSTED_ORIGINS=""

# Google sign-in (optional): Google Cloud Console → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
